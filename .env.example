# Database (PostgreSQL)
DATABASE_URL="postgresql://shipbrief:shipbrief@localhost:5432/shipbrief?schema=public"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# GitHub OAuth (optional). Leave empty to connect with a personal access token (PAT) instead.
# OAuth App / GitHub App is useful for production-like one-click login. Local dogfood: use PAT.
# Callback URL if you do set these up: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: restrict GitHub token scopes. Default is read-only public:
#   read:user public_repo
# Classic OAuth has no private read-only scope. For private repos set:
#   GITHUB_SCOPE="read:user repo"
# Prefer a GitHub App with Contents: Read-only instead.
# GITHUB_SCOPE="read:user public_repo"

# Demo / sample-repo sign-in. Isolated per session (not a shared demo@ user).
# Off in production unless set to true. Does not use OPENAI_API_KEY (BYOK only, rate-limited).
# ALLOW_DEMO_AUTH="true"

# LLM (OpenAI-compatible). Optional — heuristic synthesis is used when unset.
# Users can also paste a BYOK key on the generate screen (sent only for that request).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Optional: force demo data even when a GitHub token exists (useful in CI)
# MOCK_GITHUB="true"
