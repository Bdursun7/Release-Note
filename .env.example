# Database (PostgreSQL)
DATABASE_URL="postgresql://shipbrief:shipbrief@localhost:5432/shipbrief?schema=public"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# GitHub OAuth (GitHub App user-to-server OAuth preferred; classic OAuth App also works)
# See README for setup. Leave empty to use Demo mode only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: restrict GitHub token scopes. Default is "read:user repo".
# GITHUB_SCOPE="read:user public_repo"

# LLM (OpenAI-compatible). Optional — heuristic synthesis is used when unset.
# Users can also paste a BYOK key on the generate screen (sent only for that request).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Optional: force demo data even when a GitHub token exists (useful in CI)
# MOCK_GITHUB="true"
